# Copy to ".env" in the project root and fill in values.
# Never commit .env — it is gitignored.

# OpenAI — cloud chat + optional Whisper/TTS later
OPENAI_API_KEY=

# Mistral — cloud chat (OpenAI-compatible API)
MISTRAL_API_KEY=

# Optional URL overrides (normally in config/lite_settings.json):
# OPENAI_BASE_URL=https://api.openai.com/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
