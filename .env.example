# Copy to ".env" in the project root and fill in values.
# Never commit .env — it is gitignored.

# OpenAI (or any OpenAI-compatible cloud). Required only when cloud is enabled.
OPENAI_API_KEY=

# Optional overrides (normally set in config/lite_settings.json instead):
# OPENAI_BASE_URL=https://api.openai.com/v1
